# ---------------------------------------------------------------------------
# Smile Studio of Rehoboth — environment configuration
# Copy to .env.local for development. Set these in the host's dashboard for
# production. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Indexing gate. MUST be "true" on the production domain ONLY.
# Any other value emits noindex,nofollow from both the meta tag and the
# X-Robots-Tag header, and returns an empty sitemap. This is what keeps
# staging and preview deployments out of Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Shows the amber internal placeholder notes in a production build.
# Use on staging so reviewers can see outstanding items. Leave unset in prod.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- Mail (server-side only, never exposed to the browser) -----------------
# Resend API key. Optional. Submissions are always stored in Netlify Forms;
# this adds a direct email notification on top. Logged to the console in dev.
RESEND_API_KEY=

# Must be an address on an authenticated sending domain with SPF, DKIM, and
# DMARC configured. Never send as the visitor's own address.
MAIL_FROM="Smile Studio of Rehoboth <notifications@rehobothsmiles.com>"

# Where form notifications are delivered.
MAIL_TO=info@rehobothsmiles.com

# --- CRM (server-side only, read by netlify/functions/submission-created.ts) --
# Shared secret sent as x-webhook-secret to the Freedom Dental Health CRM.
# Same value the DCAD site uses. Without it the CRM hand-off is skipped and
# the lead stays in Netlify Forms only.
CRM_WEBHOOK_SECRET=

# The CRM's numeric location id for Smile Studio of Rehoboth. DCAD Wilmington
# is 12; Rehoboth's id has to come from whoever administers the CRM.
CRM_LOCATION_ID=

# --- Analytics (optional; nothing loads if both are empty) ----------------
# Consent Mode v2 defaults to denied for analytics and ad storage. A CMP must
# call gtag('consent','update',...) before anything is written.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity project id. Session recordings and heatmaps.
NEXT_PUBLIC_CLARITY_ID=

# --- Opinly (blog content) ------------------------------------------------
# Articles written in Opinly are fetched server-side and rendered by the
# existing /blog route, alongside the locally authored posts in
# src/content/blog.ts. Both values must be present or the integration stays
# off and the blog shows the local posts only, which is the pre-Opinly
# behaviour. Nothing breaks when these are unset.
#
# Secret. Set in the Netlify dashboard, never in the repository.
OPINLY_API_KEY=

# Public, not a secret: the 21-character namespace for this site's images on
# cdn.opinly.ai. next.config.mjs rewrites /blog-images/* to that CDN path, so
# article images are served from our own origin and the Content-Security-Policy
# needs no external image host. Must be exactly 21 characters.
OPINLY_CDN_NAMESPACE=
