# ---------------------------------------------------------------------------
# Smile Studio of Rehoboth — environment configuration
# Copy to .env.local for development. Set these in the host's dashboard for
# production. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Indexing gate. MUST be "true" on the production domain ONLY.
# Any other value emits noindex,nofollow from both the meta tag and the
# X-Robots-Tag header, and returns an empty sitemap. This is what keeps
# staging and preview deployments out of Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Shows the amber internal placeholder notes in a production build.
# Use on staging so reviewers can see outstanding items. Leave unset in prod.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- Mail (server-side only, never exposed to the browser) -----------------
# Resend API key. Without it, form submissions log in dev and FAIL in prod.
RESEND_API_KEY=

# Must be an address on an authenticated sending domain with SPF, DKIM, and
# DMARC configured. Never send as the visitor's own address.
MAIL_FROM="Smile Studio of Rehoboth <notifications@rehobothsmiles.com>"

# Where form notifications are delivered.
MAIL_TO=info@rehobothsmiles.com

# --- Analytics (optional; nothing loads if both are empty) ----------------
# Consent Mode v2 defaults to denied for analytics and ad storage. A CMP must
# call gtag('consent','update',...) before anything is written.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
